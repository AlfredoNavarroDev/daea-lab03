<Window x:Class="daea_lab03.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:daea_lab03.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Ingreso al sistema" Height="480" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- Brand panel -->
                <Border Grid.Column="0" Background="{StaticResource BrandGradientBrush}" CornerRadius="16,0,0,16">
                    <StackPanel VerticalAlignment="Center" Margin="36">
                        <Border Width="56" Height="56" CornerRadius="14" Background="#22FFFFFF" Margin="0,0,0,24">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Reservas de Aulas" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="Gestiona la disponibilidad de espacios y reserva un aula en segundos."
                                   FontSize="14" Foreground="#DFF7F3" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- Form panel -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="48,0">
                    <TextBlock Text="Bienvenido" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Ingresa tus credenciales para continuar" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,28" />

                    <TextBlock Text="USUARIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />

                    <TextBlock Text="CONTRASEÑA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,24" />

                    <Button Content="Ingresar" Style="{StaticResource AccentButtonStyle}" Click="Ingresar_Click" />

                    <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource DestructiveBrush}"
                               FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
